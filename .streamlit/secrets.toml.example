api_token = ""   # Bearer token for the Incorta catalog API
cluster   = ""   # Base URL of the Incorta cluster, e.g. https://your-cluster.incorta.com
tenant    = ""   # Incorta tenant name

# Metadata tables used for ID resolution (schema-qualified; quote reserved words)
dashboard_table = "_incortaMetadata.DASHBOARD"
user_table      = "_incortaMetadata.USER"

[connections.marketplace]
url = ""         # postgresql+psycopg2://user:pass@host:port/db?sslmode=require
